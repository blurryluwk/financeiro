// prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

// Usuários
model User {
  id           Int         @id @default(autoincrement()) 
  name         String
  email        String      @unique
  password_hash String
  created_at   DateTime    @default(now())
  
  categories   Category[]
  transactions Transaction[]
  budgets  Budget[]
  profilePicture    ProfilePicture?

  @@map("users")
}

// Categorias
model Category {
  id      Int      @id @default(autoincrement())
  name    String
  user_id Int
  user    User     @relation(fields: [user_id], references: [id])
  
  transactions Transaction[]
  budgets  Budget[]

  @@map("categories")
}

// Transações
model Transaction {
  id          Int       @id @default(autoincrement())
  description String
  amount      Float
  date        DateTime
  type        String
  category_id Int
  category    Category  @relation(fields: [category_id], references: [id])
  created_at  DateTime  @default(now())
  user_id     Int
  user        User      @relation(fields: [user_id], references: [id])
  @@map("transactions")
}

// Orçamentos
model Budget {
  id          Int      @id @default(autoincrement())
  user_id     Int
  category_id Int
  amount      Float
  user        User     @relation(fields: [user_id], references: [id])
  category    Category @relation(fields: [category_id], references: [id])

  @@map("budgets")
}

//Fotos de Perfil
model ProfilePicture {
  user_id     Int       @id @map("user_id")
  photo       Bytes     @map("photo")
  uploaded_at DateTime  @default(now()) @map("uploaded_at")
  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("profile_photos")
}
